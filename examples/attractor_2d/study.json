{
  "replicates": {
    "count": 1,
    "scheduling": "sequential",
    "failure_policy": "fail_fast",
    "base_seed": 1101
  },
  "phases": {
    "simulate": {
      "tasks": [
        {
          "model": "attractor",
          "input": "inputs/run.json",
          "display": {"include": ["point", "radius"]}
        }
      ],
      "max_concurrency": 3,
      "start_interval_ms": 3000
    }
  }
}
