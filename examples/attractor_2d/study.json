{
  "phases": {
    "simulate": {
      "tasks": [
        {
          "model": "attractor"
        }
      ],
      "max_concurrency": 3,
      "start_interval_ms": 2000
    },
    "plot": {
      "after": ["simulate"],
      "tasks": [
        {
          "python": {
            "script": "scripts/plot.py",
            "environment": {
              "manager": "system"
            }
          }
        }
      ]
    }
  }
}
