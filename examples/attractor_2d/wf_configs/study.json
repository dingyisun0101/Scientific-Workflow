{
  "threads": 4,
  "paths": {
    "states": {
      "attractor": "wf_configs/states/attractor.json"
    }
  },
  "phases": {
    "simulate": {
      "tasks": [
        {
          "execution_unit": "attractor",
          "state": "attractor"
        }
      ],
      "max_concurrency": 3,
      "start_interval_ms": 2000
    },
    "plot": {
      "after": ["simulate"],
      "tasks": [
        {
          "python": {
            "script": "scripts/plot.py",
            "environment": {
              "manager": "system"
            }
          }
        }
      ]
    }
  }
}
