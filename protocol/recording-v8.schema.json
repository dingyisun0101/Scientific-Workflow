{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dingyisun0101/Scientific-Workflow/protocol/recording-v8.schema.json",
  "title": "Scientific Workflow JSONL recording metadata v8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "status",
    "timing",
    "records",
    "time",
    "streams"
  ],
  "properties": {
    "format": {
      "const": "scientific-workflow-jsonl"
    },
    "version": {
      "const": 8
    },
    "status": {
      "$ref": "#/$defs/status"
    },
    "timing": {
      "$ref": "#/$defs/timing"
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "framing"
      ],
      "properties": {
        "encoding": {
          "const": "json"
        },
        "framing": {
          "const": "json_lines"
        }
      }
    },
    "time": {
      "$ref": "#/$defs/time"
    },
    "user_metadata": {
      "type": "object"
    },
    "terminal_metadata": {
      "type": "object"
    },
    "streams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stream"
      }
    }
  },
  "$defs": {
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "positive_u64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "nonblank": {
      "type": "string",
      "pattern": ".*\\S.*"
    },
    "utc_rfc3339": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "status": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "running"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "complete"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "message"
          ],
          "properties": {
            "state": {
              "const": "failed"
            },
            "message": {
              "$ref": "#/$defs/nonblank"
            }
          }
        }
      ]
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at_utc",
        "active_duration_ns",
        "continuation_count"
      ],
      "properties": {
        "created_at_utc": {
          "$ref": "#/$defs/utc_rfc3339"
        },
        "finalized_at_utc": {
          "oneOf": [
            {
              "$ref": "#/$defs/utc_rfc3339"
            },
            {
              "type": "null"
            }
          ]
        },
        "active_duration_ns": {
          "$ref": "#/$defs/u64"
        },
        "continuation_count": {
          "$ref": "#/$defs/u64"
        }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iteration_name"
      ],
      "properties": {
        "iteration_name": {
          "$ref": "#/$defs/nonblank"
        },
        "iteration_unit": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonblank"
            },
            {
              "type": "null"
            }
          ]
        },
        "physical_time_name": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonblank"
            },
            {
              "type": "null"
            }
          ]
        },
        "physical_time_unit": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonblank"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonblank"
        },
        "description": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonblank"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "layout": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "target_bytes"
          ],
          "properties": {
            "kind": {
              "const": "chunked"
            },
            "target_bytes": {
              "$ref": "#/$defs/positive_u64"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "individual_files"
            }
          }
        }
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout",
        "storage_queue_bytes"
      ],
      "properties": {
        "layout": {
          "$ref": "#/$defs/layout"
        },
        "storage_queue_bytes": {
          "$ref": "#/$defs/positive_u64"
        }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ordinal",
        "file",
        "records",
        "bytes",
        "checksum",
        "first_iteration",
        "last_iteration"
      ],
      "properties": {
        "ordinal": {
          "$ref": "#/$defs/u64"
        },
        "file": {
          "type": "string",
          "pattern": "^chunk-[0-9]{6,}\\.jsonl$"
        },
        "records": {
          "$ref": "#/$defs/positive_u64"
        },
        "bytes": {
          "$ref": "#/$defs/positive_u64"
        },
        "checksum": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "first_iteration": {
          "$ref": "#/$defs/u64"
        },
        "last_iteration": {
          "$ref": "#/$defs/u64"
        }
      }
    },
    "stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "directory",
        "sampling_interval",
        "fields",
        "storage"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonblank"
        },
        "directory": {
          "$ref": "#/$defs/nonblank"
        },
        "sampling_interval": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "iterations"
              ],
              "properties": {
                "iterations": {
                  "$ref": "#/$defs/positive_u64"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "initial_and_final"
              ],
              "properties": {
                "initial_and_final": {
                  "const": true
                }
              }
            }
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "storage": {
          "$ref": "#/$defs/storage"
        },
        "chunks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chunk"
          }
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "iteration",
        "values"
      ],
      "properties": {
        "iteration": {
          "$ref": "#/$defs/u64"
        },
        "physical_time": {
          "type": [
            "number",
            "null"
          ]
        },
        "values": {
          "type": "array"
        }
      }
    }
  }
}
